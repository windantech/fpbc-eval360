# ─── Application ──────────────────────────────────────────────────
APP_NAME="FPC"
APP_ENV=development              # development | production
APP_DEBUG=true                   # false in production
APP_URL=http://localhost/FPC
APP_TIMEZONE=Africa/Nairobi

# 32-byte key. Generate one, do not invent it:  php scripts/generate_key.php
# Used to encrypt secrets held in the database. Changing it makes anything
# already encrypted unreadable.
APP_KEY=

# ─── Client identity ──────────────────────────────────────────────
CLIENT_SLUG=fpc
CLIENT_NAME="Future Planning for the Child"
CLIENT_FULL_NAME="Future Planning for the Child"

# ─── Database ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fpc
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ─── Session ──────────────────────────────────────────────────────
SESSION_SECURE_COOKIE=false      # true once the deployment is HTTPS
SESSION_LIFETIME_MIN=480

# ─── Storage ──────────────────────────────────────────────────────
STORAGE_BACKEND=local            # local | s3
STORAGE_PATH=storage/uploads
STORAGE_MAX_UPLOAD_MB=20

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_CHANNEL=file
LOG_RETENTION_DAYS=90
